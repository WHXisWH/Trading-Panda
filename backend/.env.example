# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg URL; after setting: cd backend && alembic upgrade head
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/trading_panda

# ── Redis（Upstash · Python TCP rediss://）────────────────────────────────────
REDIS_URL=rediss://default:YOUR_UPSTASH_REDIS_PASSWORD@your-instance.upstash.io:6379

# Cloudflare WebSocket Hub only (same Upstash DB; do not use in backend/monitor):
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# ── LLM (DeepSeek V3) ────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AGENT_TIMEOUT_SECONDS=3

# ── Sui Blockchain ────────────────────────────────────────────────────────────
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_PRIVATE_KEY=base64-encoded-private-key
PACKAGE_ID=0x595087bb3e5f6c5011585797e4eb4db513b55d39ce84f984bb357e9375c11465
REGISTRY_ID=0x5cbf822c3fe346d7001125ff0ad52d675611148b2c4734d1e200ebf23d53baa5

# ── Walrus ────────────────────────────────────────────────────────────────────
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# ── Auth（与 frontend JWT_SECRET / websocket JWT_SECRET 一致）────────────────
JWT_SECRET=replace-with-32-byte-random-hex-min-32-chars
INTERNAL_SECRET=replace-with-32-byte-random-hex-min-32-chars
# Optional: validate zkLogin Google id_token aud
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# ── Runtime ───────────────────────────────────────────────────────────────────
PORT=8000
MAX_ACTORS=100
MERKLE_BATCH_SIZE=50
DEBUG=false
