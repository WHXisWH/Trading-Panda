# ── Public (browser) ─────────────────────────────────────────────────────────
# Python Decision Engine (Render); used by docs/tooling — BFF uses BACKEND_URL server-side
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# WebSocket Hub (Plan A): market.tick + panda events — single WSS connection
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8787/ws
# Historical candles: BFF → market-monitor GET /candles (server prefers MARKET_MONITOR_URL)
MARKET_MONITOR_URL=http://localhost:8001
# NEXT_PUBLIC_MARKET_MONITOR_URL=http://localhost:8001
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_PACKAGE_ID=0x595087bb3e5f6c5011585797e4eb4db513b55d39ce84f984bb357e9375c11465
NEXT_PUBLIC_REGISTRY_ID=0x5cbf822c3fe346d7001125ff0ad52d675611148b2c4734d1e200ebf23d53baa5
# zkLogin Google OAuth Client ID (Web application; redirect: https://your-app/auth/zklogin-callback)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
# Panda appearance lab (/panda-lab): on in development; set true to enable in production
# NEXT_PUBLIC_ENABLE_PANDA_LAB=true

# ── Server-only (Next.js API Routes / BFF) ───────────────────────────────────
# Must match NEXT_PUBLIC_BACKEND_URL in local dev unless using separate internal URL
BACKEND_URL=http://localhost:8000
# HS256 secret — shared with backend JWT_SECRET and websocket Worker JWT_SECRET
JWT_SECRET=replace-with-32-byte-random-hex-min-32-chars
# BFF → Decision Engine internal routes (simulation start/stop)
INTERNAL_SECRET=replace-with-32-byte-random-hex-min-32-chars
