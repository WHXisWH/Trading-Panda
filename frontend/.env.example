# ── Public (exposed to browser) ──────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=https://your-app.onrender.com
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_PACKAGE_ID=0xYOUR_PACKAGE_ID
NEXT_PUBLIC_REGISTRY_ID=0xYOUR_REGISTRY_OBJECT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID

# ── Server-only (never exposed to browser) ───────────────────────────────────
# Used by Next.js API routes (API Gateway layer)
BACKEND_URL=https://your-app.onrender.com
JWT_SECRET=replace-with-32-byte-random-hex
INTERNAL_SECRET=replace-with-32-byte-random-hex
