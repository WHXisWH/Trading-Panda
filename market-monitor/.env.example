# ── Redis（与 backend 同一 Upstash 逻辑库）────────────────────────────────────
REDIS_URL=rediss://default:password@us1-xxx.upstash.io:6379

# ── Sui / DeepBook v3 ─────────────────────────────────────────────────────────
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
DEEPBOOK_PACKAGE_ID=0xdee9
# 逗号分隔；部署前用 PoolCreated 事件查询 Testnet 池 ID
DEEPBOOK_POOL_IDS=

# ── 轮询与 K 线 ───────────────────────────────────────────────────────────────
POLL_INTERVAL_SEC=2
KLINE_INTERVAL_SEC=60

# ── Runtime ───────────────────────────────────────────────────────────────────
PORT=8001
