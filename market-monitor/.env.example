# ── Redis（与 backend 同一 Upstash 逻辑库）────────────────────────────────────
# market-monitor 用 redis-py，必须填 **TCP** 连接串（控制台 → Redis → Connect → Python）：
#   REDIS_URL=rediss://default:XXXX@trusted-ghoul-41797.upstash.io:6379
REDIS_URL=rediss://default:YOUR_UPSTASH_REDIS_PASSWORD@trusted-ghoul-41797.upstash.io:6379

# ── DeepBook PostgreSQL（方案甲：OHLCV 自 order_fills 聚合，不用 /ohclv）──────
# 主网 Indexer 推荐与 Server 同机部署（见 docs/deepbook-v3-server-local-deployment.md）
DEEPBOOK_DATABASE_URL=postgresql://user:pass@127.0.0.1:5433/deepbook

# ── DeepBook Server API（盘口等；:9008）──────────────────────────────────────
DEEPBOOK_SERVER_URL=http://localhost:9008

# ── 网络与交易对（PRD v3.1：DeepBook mainnet 为训练真相）──────────────────────
# mainnet：留空 DEEPBOOK_POOLS，由流动性排名自动选池；或显式指定 launch pairs
# testnet 开发回退：DEEPBOOK_NETWORK=testnet + DEEPBOOK_POOLS=DEEP/SUI,SUI/DBUSDC
DEEPBOOK_NETWORK=mainnet
DEEPBOOK_POOLS=SUI_USDC,DEEP_USDC
LAUNCH_PAIRS=SUI_USDC,DEEP_USDC,WAL_USDC,NS_USDC
USE_PAIR_RANKING=true
MAX_PUBLISH_PAIRS=4
STALE_THRESHOLD_SEC=120

# ── Sui JSON-RPC（池发现：suix_queryEvents → PoolCreated）────────────────────
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
DEEPBOOK_PACKAGE_ID=0x2c8d603bc51326b8c13cef9dd07031a408a48dddb541963357661df5d3204809
DEEPBOOK_POOL_MODULE=pool
USE_SUI_RPC_FOR_POOLS=true
USE_HTTP_GET_POOLS_FALLBACK=true
POOL_RPC_LIMIT_PER_PAGE=50
POOL_RPC_MAX_PAGES=20

# ── 轮询 / PG 回溯 / 缩放 ───────────────────────────────────────────────────
POLL_INTERVAL_SEC=15
FILLS_POLL_LOOKBACK_SEC=259200
FILLS_LOOKBACK_SEC=2592000
CANDLE_PERIOD=1m
OHLCV_LIMIT=60
ORDERBOOK_DEPTH=10
ORDERBOOK_LEVEL=2
PRICE_SCALE=1000000000
QTY_SCALE=1000000000
# USE_OHLCV_FALLBACK=true

# ── Runtime ─────────────────────────────────────────────────────────────────
PORT=8001
