# ── Redis（与 backend 同一 Upstash 逻辑库）────────────────────────────────────
REDIS_URL=rediss://default:password@us1-xxx.upstash.io:6379

# ── DeepBook Server API（MVP：不直连 Sui RPC）────────────────────────────────
DEEPBOOK_SERVER_URL=http://localhost:9008
# 可选；留空则从 GET /get_pools 拉取
DEEPBOOK_POOLS=

# ── 轮询 ─────────────────────────────────────────────────────────────────────
POLL_INTERVAL_SEC=2

# ── Runtime ─────────────────────────────────────────────────────────────────
PORT=8001
